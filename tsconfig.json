{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": []
  },
  "include": [
    "js/calc.js",
    "js/compute.js",
    "js/contrat-parse.js",
    "js/chain.js",
    "js/util.js",
    "js/journee.js",
    "js/bulletin-parse.js",
    "js/sauvegarde.js",
    "js/document-type.js"
  ],
  "exclude": ["vendor", "node_modules"]
}
